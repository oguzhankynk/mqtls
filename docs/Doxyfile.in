# Minimal Doxygen configuration for mqtls. Unlisted tags keep Doxygen's
# defaults. Generated from this template by cmake/Doxygen.cmake; the two
# @MQTLS_DOXYGEN_*@ placeholders below are the only things that differ
# between the 'docs' and 'docs-check' targets.

PROJECT_NAME           = "mqtls"
PROJECT_NUMBER         = "@MQTLS_VERSION@"
PROJECT_BRIEF          = "A TLS 1.3 layer over any byte-stream transport"
OUTPUT_DIRECTORY       = "@MQTLS_DOXYGEN_OUTPUT_DIR@"

INPUT                  = "@MQTLS_SOURCE_DIR@/include" \
                          "@MQTLS_SOURCE_DIR@/src" \
                          "@MQTLS_SOURCE_DIR@/docs/mainpage.md" \
                          "@MQTLS_SOURCE_DIR@/docs/architecture.md" \
                          "@MQTLS_SOURCE_DIR@/docs/threading.md" \
                          "@MQTLS_SOURCE_DIR@/docs/security.md"
FILE_PATTERNS           = *.hpp *.h *.md
RECURSIVE               = YES
EXCLUDE_PATTERNS        = */_deps/* */tests/* */build/*
USE_MDFILE_AS_MAINPAGE  = "@MQTLS_SOURCE_DIR@/docs/mainpage.md"
STRIP_FROM_PATH         = "@MQTLS_SOURCE_DIR@"

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = @MQTLS_DOXYGEN_WARN_AS_ERROR@

GENERATE_HTML           = @MQTLS_DOXYGEN_GENERATE_HTML@
GENERATE_LATEX          = NO
GENERATE_XML            = NO
SOURCE_BROWSER          = YES
HAVE_DOT                = @MQTLS_DOXYGEN_HAVE_DOT@
QUIET                   = YES
