@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenSSL 3.0)
find_dependency(Threads)
# span-lite is bundled into mqtlsTargets.cmake directly (see the root
# CMakeLists.txt install section); tl::expected installs and exports its
# own package config unconditionally, so it's found the ordinary way.
find_dependency(tl-expected)

include("${CMAKE_CURRENT_LIST_DIR}/mqtlsTargets.cmake")

check_required_components(mqtls)
